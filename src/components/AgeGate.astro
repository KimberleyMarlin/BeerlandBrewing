---
// Full-screen 18+ check shown over every page until the visitor confirms.
// The inline script in BaseLayout decides whether to show it before the page paints.
import badge from '../assets/brand/badge.svg';
---
<div class="age-gate" data-age-gate>
  <div role="dialog" aria-modal="true" aria-labelledby="age-title" class="age-gate__box">
    <img src={badge.src} width="190" height="190" alt="Beerland Brewing" class="age-gate__badge" />
    <div class="age-gate__rule" aria-hidden="true"><span></span><i></i><span></span></div>

    <div class="age-gate__state stack" data-age-ask>
      <div class="eyebrow">Before you come in…</div>
      <h1 id="age-title" class="age-gate__title">Are you 18 or over?</h1>
      <p class="age-gate__text">You must be of legal drinking age in Australia to enter this site.</p>
      <div class="age-gate__actions">
        <button type="button" class="btn btn--solid btn--lg" data-age-yes>Yes, I'm 18+</button>
        <button type="button" class="btn btn--line btn--lg" data-age-no>No</button>
      </div>
      <label class="age-gate__remember">
        <input type="checkbox" data-age-remember />
        <span>Remember me on this device</span>
      </label>
    </div>

    <div class="age-gate__state stack" data-age-denied hidden>
      <div class="eyebrow">Sorry, mate</div>
      <h1 class="age-gate__title">Come back when you're 18</h1>
      <p class="age-gate__text">You need to be of legal drinking age to visit the Beerland Brewing website.</p>
      <button type="button" class="age-gate__undo" data-age-undo>I clicked the wrong button</button>
    </div>

    <p class="age-gate__fine">Enjoy responsibly. It is an offence to sell or supply liquor to a person under the age of 18 years.</p>
  </div>
</div>

<script>
  const gate = document.querySelector<HTMLElement>('[data-age-gate]');
  if (gate && document.documentElement.classList.contains('age-check')) {
    const page = document.getElementById('page');
    page?.setAttribute('inert', '');
    const ask = gate.querySelector<HTMLElement>('[data-age-ask]')!;
    const denied = gate.querySelector<HTMLElement>('[data-age-denied]')!;
    gate.querySelector<HTMLButtonElement>('[data-age-yes]')?.focus();

    gate.querySelector('[data-age-yes]')?.addEventListener('click', () => {
      const remember = gate.querySelector<HTMLInputElement>('[data-age-remember]')?.checked;
      try { (remember ? localStorage : sessionStorage).setItem('bl_age', '1'); } catch {}
      document.documentElement.classList.remove('age-check');
      page?.removeAttribute('inert');
    });
    gate.querySelector('[data-age-no]')?.addEventListener('click', () => {
      ask.hidden = true; denied.hidden = false;
      gate.querySelector<HTMLButtonElement>('[data-age-undo]')?.focus();
    });
    gate.querySelector('[data-age-undo]')?.addEventListener('click', () => {
      denied.hidden = true; ask.hidden = false;
      gate.querySelector<HTMLButtonElement>('[data-age-yes]')?.focus();
    });
  }
</script>

<style>
  .age-gate {
    display: none; position: fixed; inset: 0; z-index: 100; overflow-y: auto;
    align-items: center; justify-content: center; padding: 32px 16px;
    background: rgba(10, 8, 6, .88); backdrop-filter: blur(6px);
  }
  :global(html.age-check) .age-gate { display: flex; }
  :global(html.age-check) { overflow: hidden; }
  .age-gate__box {
    width: 100%; max-width: 560px; margin: auto; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    padding: 48px clamp(20px, 5vw, 48px) 36px;
    background: var(--bg); border: 2px solid var(--accent);
    outline: 1px solid rgba(217, 154, 62, .45); outline-offset: 6px;
  }
  .age-gate__badge { width: 190px; max-width: 60%; }
  .age-gate__rule { display: flex; align-items: center; gap: 12px; width: 220px; }
  .age-gate__rule span { flex: 1; height: 1px; background: var(--accent); }
  .age-gate__rule i { width: 8px; height: 8px; background: var(--accent); transform: rotate(45deg); }
  .age-gate__state { align-items: center; gap: 20px; width: 100%; }
  .age-gate__state[hidden] { display: none; }
  .age-gate__title {
    font-family: var(--font-label); font-weight: 700; font-size: 40px; line-height: 1.05;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .age-gate__text { font-size: 16px; line-height: 1.5; color: var(--text-muted); max-width: 380px; }
  .age-gate__actions { display: flex; flex-wrap: wrap; gap: 12px; width: 100%; }
  .age-gate__actions .btn { flex: 1 1 180px; }
  .age-gate__remember { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 14px; color: var(--text-muted); cursor: pointer; }
  .age-gate__remember input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .age-gate__undo {
    min-height: 44px; padding: 0 16px; background: none; border: 0; cursor: pointer; color: var(--accent);
    font-family: var(--font-label); font-weight: 600; font-size: 16px; letter-spacing: 2px; text-transform: uppercase; text-decoration: underline;
  }
  .age-gate__fine { margin-top: 8px; font-size: 12px; line-height: 1.5; color: var(--text-faint); }
</style>
