---
// Shows an optimised image, or a labelled placeholder block when no image has been added yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  width?: number;
  placeholder?: string;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, width = 800, placeholder, class: cls, style, loading = 'lazy' } = Astro.props;
---
{src
  ? <Image src={src} alt={alt} width={Math.min(width, src.width)} class={cls} style={style} loading={loading} />
  : <div class:list={['ph stripes', cls]} style={style} role={alt ? 'img' : undefined} aria-label={alt || undefined}>
      <span aria-hidden="true">[{placeholder ?? 'Photo coming soon'}]</span>
    </div>}
