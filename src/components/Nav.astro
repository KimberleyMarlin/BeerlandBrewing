---
import wordmark from '../assets/brand/wordmark.svg';
import Icon from './Icon.astro';
import { nav } from '../config/site';
import { url } from '../scripts/url';

interface Props { current?: string; cart?: boolean }
const { current, cart = false } = Astro.props;
---
<nav class="nav wrap" aria-label="Main">
  <a href={url()} class="nav__logo">
    <img src={wordmark.src} width="116" height="67" alt="Beerland Brewing home" />
  </a>
  <div class="nav__links">
    {nav.map((item) => (
      <a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
    {cart && (
      <button type="button" class="nav__cart" data-cart-open aria-label="Cart, 0 items">
        <Icon name="bag" size={22} />
        <span class="nav__count" data-cart-count>0</span>
      </button>
    )}
    <a href="#signup" class="nav__cta">Join the list</a>
  </div>
</nav>

<style>
  .nav {
    position: relative; z-index: 2; max-width: none; width: 100%;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px;
    padding-top: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--line);
  }
  .nav__logo { display: flex; padding: 4px 0; }
  .nav__logo img { width: 116px; }
  .nav__links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px;
    font-family: var(--font-label); font-weight: 600; font-size: 16px; letter-spacing: 2px; text-transform: uppercase;
  }
  .nav__links > a:not(.nav__cta) { padding: 12px 0; border-bottom: 2px solid transparent; }
  .nav__links > a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }
  .nav__cta { padding: 10px 18px; border: 2px solid var(--accent); color: var(--accent); }
  .nav__cta:hover { border-color: var(--cream); color: var(--cream); }
  .nav__cart {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 4px;
    background: none; border: 0; cursor: pointer;
  }
  .nav__cart:hover { color: var(--accent); }
  .nav__count {
    min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent); color: var(--bg); font-family: var(--font-body); font-size: 14px; letter-spacing: 0;
  }
</style>
