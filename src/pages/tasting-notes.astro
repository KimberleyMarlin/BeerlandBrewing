---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import Signup from '../components/Signup.astro';
import { getOrdered } from '../scripts/content';
import { formatStyle } from '../scripts/format';
import { url } from '../scripts/url';

const beers = await getOrdered('beers');
const groups = [
  {
    id: 'core',
    eyebrow: 'On the tasting paddle',
    title: 'Core Range',
    intro: 'Our five core beers, always pouring at Whitfords Brewing Co. Try all five on a tasting paddle of 100ml serves.',
    beers: beers.filter((b) => b.data.range === 'core'),
  },
  {
    id: 'limited',
    eyebrow: 'Small batch · Limited edition',
    title: 'Limited Releases',
    intro: 'Small-batch beers in different styles, brewed in limited runs. Get them while they last.',
    beers: beers.filter((b) => b.data.range === 'limited'),
  },
];
---
<BaseLayout title="Tasting Notes" description="Tasting notes for every Beerland beer: style, ABV, IBU, hops and what to expect in the glass.">
  <header class="wrap tn-head">
    <div class="stack" style="flex: 1 1 480px; gap: 16px">
      <div class="eyebrow" style="font-size: 16px">What's in the glass</div>
      <h1 class="display display--xl">Tasting Notes</h1>
    </div>
    <nav class="tn-jump" aria-label="Jump to a beer">
      {groups.map((g) => (
        <div class="stack" style="gap: 6px">
          <a href={`#${g.id}`} class="tn-jump__head">{g.title}</a>
          <div class="tn-jump__links">
            {g.beers.map((b) => <a href={`#${b.id}`}>{b.data.name}</a>)}
          </div>
        </div>
      ))}
    </nav>
  </header>

  {groups.map((g) => (
    <section id={g.id} class="wrap tn-group" aria-labelledby={`${g.id}-title`}>
      <div class="section-rule stack" style="gap: 8px">
        <div class="eyebrow">{g.eyebrow}</div>
        <h2 id={`${g.id}-title`} class="display display--lg">{g.title}</h2>
        <p class="body" style="max-width: 640px">{g.intro}</p>
      </div>

      <div class="tn-list">
        {g.beers.map(({ id, data: beer }) => (
          <article id={id} class="tn-beer card">
            <div class="tn-beer__art" style={`background: ${beer.colour}`}>
              <Picture src={beer.image} alt={beer.alt} width={400} placeholder={`${beer.name} label`} class="tn-beer__label" />
            </div>
            <div class="tn-beer__text stack">
              {beer.tag && <span class="tag" style="align-self: flex-start">{beer.tag}</span>}
              <h3 class="display" style="font-size: clamp(30px, 3.4vw, 42px)">{beer.name}</h3>
              <div class="label accent" style="font-size: 17px">{formatStyle(beer.style, beer.abv)} ABV</div>
              <p class="tn-beer__summary">{beer.summary}</p>
              {beer.notes.map((n) => <p class="body">{n}</p>)}
              {beer.specs.length > 0 && (
                <dl class="tn-beer__specs">
                  {beer.specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
                </dl>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap" style="padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 12px">
    <a href={url('where-to-buy/')} class="btn btn--solid btn--lg">Where to buy</a>
    <a href={url('our-beers/')} class="btn btn--line btn--lg">Back to Our Beers</a>
  </section>

  <Signup />
</BaseLayout>

<style>
  .tn-head { padding-top: 96px; padding-bottom: 56px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px 64px; }
  .tn-jump { flex: 1 1 420px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; }
  .tn-jump__head { font-family: var(--font-label); font-weight: 700; font-size: 15px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); }
  .tn-jump__links { display: flex; flex-direction: column; }
  .tn-jump__links a { padding: 6px 0; font-size: 16px; color: var(--text-muted); }
  .tn-jump__links a:hover { color: var(--accent); }

  .tn-group { display: flex; flex-direction: column; gap: 32px; padding-bottom: 88px; }
  .tn-group, .tn-beer { scroll-margin-top: 24px; }
  .tn-list { display: flex; flex-direction: column; gap: 24px; }

  .tn-beer { display: flex; flex-wrap: wrap; overflow: hidden; }
  .tn-beer__art { flex: 0 1 300px; min-width: 0; display: flex; align-items: center; justify-content: center; padding: 32px 24px; }
  .tn-beer__art :global(.tn-beer__label) { width: 220px; max-width: 100%; aspect-ratio: 512 / 794; object-fit: cover; border-radius: 6px; box-shadow: 0 18px 36px rgba(0, 0, 0, .45); }
  .tn-beer__art :global(.ph.tn-beer__label) { background-color: rgba(0, 0, 0, .25); color: var(--cream-soft); }
  .tn-beer__text { flex: 1 1 420px; gap: 14px; padding: 36px clamp(24px, 4vw, 52px); justify-content: center; }
  .tn-beer__summary { font-size: 19px; line-height: 1.45; color: var(--cream-soft); }
  .tn-beer__specs {
    margin: 4px 0 0; padding-top: 14px; border-top: 1px solid var(--line);
    display: grid; gap: 12px 24px; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
  }
  .tn-beer__specs div { display: flex; flex-direction: column; gap: 2px; }
  .tn-beer__specs dt { font-family: var(--font-label); font-weight: 600; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-faint); }
  .tn-beer__specs dd { margin: 0; font-size: 16px; }

  @media (max-width: 720px) {
    .tn-beer__art { flex-basis: 100%; }
  }
</style>
